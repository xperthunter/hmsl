#!/usr/bin/env bash

echo "here"
CALLER="$(readlink -f "$0")"
HMSL="$(cd "$(dirname "$CALLER")/.." && pwd)"

usage()
{
	cat << EOF
==================================================
 HMSL - HVCC Learning Management System for Linux
==================================================

Usage:
	hmsl <subcommand> [arguments]

Subcommands:
	exercise <lab> Start working on lab <lab>
	score <lab>    Grade a lab
	reset <lab>    Reset a lab to do more practice
	help           Show this help message

Examples:
	hmsl exercise lab01
	hmsl score lab01
	hmsl reset lab01
	hmsl help
	hmsl test

EOF
}

check_lab()
{
	local lab="$1"
	
	if [[ -z "$lab" ]]; then
		echo "Missing lab name."
		exit 1
	fi
	
	if [[ ! -f "${HMSL}/labs/${lab}/${lab}.sh" ]]; then
		echo "Unknown lab: $lab"
		exit 1
	fi
}

if [[ $# -eq 0 ]]; then
	usage
	exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
	exercise )
		lab="$1"
		check_lab "$lab"
		source "${HMSL}/lib/exercise.sh"
		exercise "$lab"
	;;
	score ) 
		lab="$1"
		check_lab "$lab"
		source "${HMSL}/lib/score.sh"
		source "${HMSL}/labs/${lab}/${lab}.sh"
	;;
	reset ) 
		lab="$1"
		check_lab "$lab"
		source "${HMSL}/lib/reset.sh"
		reset_lab "$lab"
	;;
	help|-h|--help|"" )
		usage
		exit 0
	;;
	test ) source "${HMSL}/tests/run_tests.sh"
	;;
	* ) echo "Unknown command: $COMMAND"
		exit 1
	;;
esac
